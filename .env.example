# BTC Trading Bot — Environment Configuration Template
ENV=development
LOG_LEVEL=INFO

# Private dashboard access (strong random value recommended on Railway)
DASHBOARD_ADMIN_TOKEN=change_me_to_a_long_random_value

# Asset
SYMBOL=BTC/USDT
BINANCE_SYMBOL=BTCUSDT

# Binance Futures TESTNET account
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_TESTNET=true
BINANCE_RECV_WINDOW_MS=5000
ACCOUNT_READ_ONLY=true

# External context APIs
COINGLASS_API_KEY=your_coinglass_api_key_here
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here

# Telegram
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_NOTIFY_WAIT=false

# Optional advisory AI (does NOT control execution)
AI_ENABLED=false
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5-mini
AI_TIMEOUT_SEC=20

# News intelligence
NEWS_ENABLED=true
NEWS_MAX_ITEMS=20
NEWS_LOOKBACK_HOURS=24
NEWS_RSS_URLS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss,https://decrypt.co/feed

# Risk Parameters
INITIAL_CAPITAL_USDT=10000.0
TREND_RISK_PCT=0.0050
COUNTER_TREND_RISK_PCT=0.0025
MIN_RISK_REWARD=1.5
MAX_ACCOUNT_LEVERAGE=5

# Kill Switch
MAX_DAILY_LOSS_PCT=0.02
MAX_CONSECUTIVE_LOSSES=3
MAX_API_LATENCY_MS=3000
