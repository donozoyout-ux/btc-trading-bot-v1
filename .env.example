# BTC Trading Bot — Environment Configuration Template
ENV=development
LOG_LEVEL=INFO

# Asset
SYMBOL=BTC/USDT
BINANCE_SYMBOL=BTCUSDT

# Binance Futures (USDT-M) API Keys
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_TESTNET=true
BINANCE_RECV_WINDOW=5000
ACCOUNT_READ_ONLY=true
ORDER_SUBMISSION_ENABLED=false
RUN_EXECUTION_SMOKE_TEST=false
TEST_ORDER_NOTIONAL_USDT=10
TEST_ORDER_MAX_NOTIONAL_USDT=100
MAX_OPEN_POSITIONS=1
EXECUTION_POLL_SECONDS=15

# External API Keys (Optional macro/derivatives context)
COINGLASS_API_KEY=your_coinglass_api_key_here
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here

# Telegram notification channel (optional, backend-only)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_DEDUPE_TTL_SECONDS=3600

# Context intelligence (AI is advisory-only)
NEWS_ENABLED=true
NEWS_RSS_URLS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss
NEWS_CACHE_SECONDS=300
AI_ENABLED=false
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5

# Optional protection for account/AI/Telegram helper endpoints
DASHBOARD_ADMIN_TOKEN=your_dashboard_admin_token_here

# Keep true for observation. Explicit TESTNET execution requires false.
SHADOW_MODE=true

# Risk Parameters
INITIAL_CAPITAL_USDT=10000.0
TREND_RISK_PCT=0.0050
COUNTER_TREND_RISK_PCT=0.0025
MIN_RISK_REWARD=1.5
MAX_ACCOUNT_LEVERAGE=5

# Adaptive Profit Protection V2 initial hypotheses (not optimized guarantees)
PROFIT_PROTECTION_ENABLED=true
PROFIT_ARM_R=0.60
BREAKEVEN_TRIGGER_R=0.75
PROFIT_LOCK_1_TRIGGER_R=1.00
PROFIT_LOCK_1_R=0.20
PROFIT_LOCK_2_TRIGGER_R=1.50
PROFIT_LOCK_2_R=0.60
PROFIT_LOCK_3_TRIGGER_R=2.00
PROFIT_LOCK_3_R=1.10
MFE_GIVEBACK_ENABLED=true
MFE_GIVEBACK_ARM_R=0.80
MFE_GIVEBACK_WARN_R=0.35
MFE_GIVEBACK_EXIT_R=0.55
PROFIT_FADE_PARTIAL_MIN_R=0.80
PROFIT_FADE_PARTIAL_FRACTION=0.35

# Kill Switch
MAX_DAILY_LOSS_PCT=0.02
MAX_CONSECUTIVE_LOSSES=3
MAX_API_LATENCY_MS=3000
